{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ems-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}{Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ems_db;Username=ems;Password=ems_password"
  },
  "AllowedHosts": "*",
  "Geocoding": {
    "BaseUrl": "https://nominatim.openstreetmap.org/",
    "UserAgent": "EMS-Attendance/1.0 (contact: admin@example.com)"
  },
  "Payroll": {
    "StandardMonthlyHours": 208,
    "OvertimeMultiplier": 1.5,
    "DefaultDailyShiftMinutes": 480
  },
  "Reimbursements": {
    "MileageRatePerKm": 0.30
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "MfaVerify": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "WriteAction": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "AttachmentUpload": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  }
}
